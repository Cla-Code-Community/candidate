meta {
  name: SearchJobs
  type: http
  seq: 1
}

get {
  url: {{base_url}}/jobs/search?location=Brasil&level=pleno&keywords=node&modality=remota
  body: none
  auth: inherit
}

params:query {
  location: Brasil
  level: pleno
  keywords: node
  modality: remota
}

headers {
  Cookie: {{sessionCookie}}
}

settings {
  encodeUrl: true
  timeout: 0
}
